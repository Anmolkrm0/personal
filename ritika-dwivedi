.pillars{display:grid;gap:1px;background:var(--line);border:1px solid var(--line)}
.pillar{background:var(--surface);padding:28px;min-height:170px;transition:.25s}
.pillar:hover{transform:translateY(-5px);background:var(--accent);color:#fff}
.pillar:hover p,.pillar:hover .index{color:rgba(255,255,255,.72)}
.pillar .index{font-size:12px;color:var(--accent);font-weight:700}
.pillar h3{font:700 1.55rem Manrope,sans-serif;margin:34px 0 8px}
.pillar p{font-size:14px;color:var(--muted);margin:0}
.timeline{position:relative;border-left:1px solid var(--line);margin-left:8px}
.role{position:relative;padding:0 0 62px 34px}
.role:before{content:"";position:absolute;left:-5px;top:5px;width:9px;height:9px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 7px var(--bg)}
.role-top{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
.company{font:700 1.35rem Manrope,sans-serif}
.date{font-size:12px;color:var(--muted);padding-top:5px}
.role h4{font-size:15px;margin:7px 0 14px;color:var(--accent)}
.role p{font-size:14px;color:var(--muted);max-width:720px;margin:0}
.story-grid{display:grid;gap:20px}
.story{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:30px;box-shadow:var(--shadow);transition:.3s}
.story:hover{transform:translateY(-5px)}
.story .label{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);font-weight:700}
.story h3{font:700 clamp(1.7rem,4vw,2.5rem)/1.1 Manrope,sans-serif;letter-spacing:-.04em;margin:20px 0 28px}
.story dl{margin:0;display:grid;grid-template-columns:100px 1fr;gap:13px;font-size:14px}
.story dt{color:var(--muted);font-weight:600}
.story dd{margin:0}
.outcome{margin-top:28px;padding-top:22px;border-top:1px solid var(--line)}
.outcome strong{font-size:20px;color:var(--accent)}
.leadership{display:grid;gap:24px}
.lead-copy{font-size:clamp(1.4rem,3vw,2.2rem);line-height:1.35;letter-spacing:-.03em}
.cap-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}
.cap{background:var(--surface);padding:22px;font-weight:700}
.cap small{display:block;color:var(--muted);font-weight:400;margin-top:6px}
.flow{display:grid;gap:0;border:1px solid var(--line)}
.flow-step{position:relative;padding:24px 22px;background:var(--surface);border-bottom:1px solid var(--line)}
.flow-step:last-child{border-bottom:0}
.flow-step:not(:last-child):after{content:"↓";position:absolute;right:22px;bottom:-17px;z-index:2;width:32px;height:32px;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center;background:var(--bg);color:var(--accent)}
.flow-step .n{font-size:11px;color:var(--accent);font-weight:700;letter-spacing:.12em}
.flow-step strong{display:block;font:700 1.4rem Manrope,sans-serif;margin:5px 0}
.flow-step span{font-size:13px;color:var(--muted)}
.tags{display:flex;flex-wrap:wrap;gap:10px}
.tag{padding:11px 14px;border:1px solid var(--line);border-radius:999px;background:var(--surface);font-size:13px}
.recognition{display:grid;gap:18px}
.award{border-top:1px solid var(--line);padding-top:24px;display:flex;gap:18px;align-items:flex-start}
.award-num{font:800 2rem/1 Manrope,sans-serif;color:var(--accent)}
.award strong{display:block;font-size:17px}.award p{margin:5px 0 0;color:var(--muted);font-size:14px}
.edu-grid{display:grid;gap:16px}
.edu{padding:26px;background:var(--surface);border:1px solid var(--line)}
