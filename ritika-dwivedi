.btn:hover{transform:translateY(-2px);box-shadow:0 10px 25px rgba(0,0,0,.08)}
.btn.primary:hover{background:var(--accent);border-color:var(--accent);color:#fff}
.metrics{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.metric{padding:22px 18px 22px 0}
.metric:nth-child(odd){border-right:1px solid var(--line)}
.metric:nth-child(n+3){border-top:1px solid var(--line)}
.metric strong{display:block;font:800 clamp(2rem,5vw,3.3rem)/1 Manrope,sans-serif;letter-spacing:-.06em}
.metric span{display:block;margin-top:8px;color:var(--muted);font-size:13px}
.scroll{display:none}
.section{padding:110px 0}
.section.alt{border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.section-head{display:flex;flex-direction:column;gap:14px;margin-bottom:54px}
.kicker{color:var(--accent);font-size:12px;text-transform:uppercase;letter-spacing:.16em;font-weight:700}
.section h2{font:800 clamp(2.5rem,6vw,5rem)/1 Manrope,sans-serif;letter-spacing:-.065em;margin:0;max-width:800px}
.editorial{font-size:clamp(1.35rem,3vw,2.2rem);line-height:1.35;letter-spacing:-.03em;max-width:950px}
.editorial b{font-weight:700}
.impact-grid{display:grid;gap:1px;background:var(--line);border:1px solid var(--line)}
.impact{background:var(--surface);padding:30px;min-height:230px;display:flex;flex-direction:column;justify-content:space-between}
