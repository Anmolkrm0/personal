<script>
const nav=document.getElementById('nav');
const theme=document.getElementById('theme');
const menu=document.getElementById('menu');
const mobile=document.getElementById('mobileMenu');

window.addEventListener('scroll',()=>nav.classList.toggle('scrolled',scrollY>24),{passive:true});

const saved=localStorage.getItem('ritika-theme');
if(saved) document.documentElement.dataset.theme=saved;
theme.addEventListener('click',()=>{
  const next=document.documentElement.dataset.theme==='dark'?'light':'dark';
  document.documentElement.dataset.theme=next;
  localStorage.setItem('ritika-theme',next);
});

menu.addEventListener('click',()=>{
  const open=mobile.classList.toggle('open');
  menu.setAttribute('aria-expanded',open);
});
mobile.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{
  mobile.classList.remove('open'); menu.setAttribute('aria-expanded','false');
}));

const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
if(!reduced){
  const observer=new IntersectionObserver(entries=>{
    entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');observer.unobserve(e.target)}});
  },{threshold:.12});
  document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));
}else document.querySelectorAll('.reveal').forEach(el=>el.classList.add('visible'));
</script>
