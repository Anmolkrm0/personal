*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:88px}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"DM Sans",system-ui,sans-serif;line-height:1.6;overflow-x:hidden}
a{color:inherit;text-decoration:none}
button{font:inherit}
::selection{background:var(--accent);color:#fff}
.container{width:min(calc(100% - 40px),var(--max));margin:auto}
.nav{position:fixed;z-index:50;top:0;left:0;right:0;border-bottom:1px solid transparent;background:transparent;transition:.3s}
.nav.scrolled{background:var(--nav);border-color:var(--line);backdrop-filter:blur(18px)}
