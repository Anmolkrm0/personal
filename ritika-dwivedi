 .impact-grid{grid-template-columns:repeat(2,1fr)}.pillars{grid-template-columns:repeat(5,1fr)}
 .story-grid{grid-template-columns:repeat(3,1fr)}.leadership{grid-template-columns:1fr 1.1fr}
 .flow{grid-template-columns:repeat(6,1fr)}.flow-step{border-bottom:0;border-right:1px solid var(--line);min-height:190px}.flow-step:last-child{border-right:0}.flow-step:not(:last-child):after{content:"→";right:-17px;bottom:auto;top:50%;transform:translateY(-50%)}
 .edu-grid{grid-template-columns:repeat(2,1fr)}
}
@media(min-width:1000px){
 .hero{padding-top:160px}.hero h1{max-width:1050px}.scroll{display:block;position:absolute;bottom:34px;right:0;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);writing-mode:vertical-rl}
 .impact-grid{grid-template-columns:repeat(3,1fr)}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.reveal{opacity:1;transform:none;transition:none}*{transition:none!important}}
</style>
</head>
